# Copy this file to .env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (sensible defaults are built in)
PORT=3000
# Comma-separated list of origins allowed to call the API. Leave empty for same-origin / dev use.
CORS_ORIGINS=
TEXT_MODEL=openai/gpt-oss-20b
VISION_MODEL=qwen/qwen3.8-27b
TRANSCRIBE_MODEL=whisper-large-v3-turbo
